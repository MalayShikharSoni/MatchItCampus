# Normalise line endings so Windows and other laptops don't produce noisy diffs.
* text=auto

# Shell script must keep LF or it breaks on macOS/Linux; batch file needs CRLF.
gradlew text eol=lf
*.bat text eol=crlf

# Binary files: never touch line endings or try to diff them.
*.jar binary
*.tflite binary
*.png binary
*.webp binary
*.jpg binary
