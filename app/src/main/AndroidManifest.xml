<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase Auth and Firestore talk to Google's servers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityObserver watches for the network coming back, to push pending changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 6: "Use my location", the map's my-location dot and "Near me". Both are declared so
         the user can choose precise or approximate on Android 12+. Only while the app is open:
         there is deliberately no ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- android:name points Android at our Application subclass, which builds the AppContainer. -->
    <application
        android:name=".MatchItApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MatchItCampus">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MatchItCampus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
